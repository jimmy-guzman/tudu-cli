{
  "name": "@odot/cli",
  "version": "0.0.0",
  "description": "A Minimal, Smart To-Do CLI.",
  "license": "MIT",
  "author": "Jimmy Guzman Moreno",
  "type": "module",
  "bin": {
    "odot": "./bin/odot.ts"
  },
  "scripts": {
    "dev": "bun bin/odot",
    "format": "biome format .",
    "knip": "knip",
    "lint": "biome lint .",
    "typecheck": "tsc",
    "compile": "bun build bin/odot.ts --compile --outfile dist/odot"
  },
  "dependencies": {
    "@clack/prompts": "0.10.0",
    "cleye": "^1.3.4",
    "picocolors": "^1.1.1",
    "valibot": "1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "latest",
    "@types/node": "22.13.13",
    "knip": "5.46.0",
    "typescript": "5.8.2"
  },
  "packageManager": "bun@1.2.5",
  "engines": {
    "bun": ">=1.0.0"
  }
}
